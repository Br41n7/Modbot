# ───────── REQUIRED ─────────
# Owner WhatsApp number(s): digits only, country code first, NO "+" (comma-separate for several).
# Only these numbers can run owner commands.
OWNER_NUMBERS=2348012345678

# ───────── OPTIONAL: identity ─────────
# If .whoami shows you as role "user" in some groups (WhatsApp LID privacy IDs),
# put the LID digits that .whoami prints here. See docs/02-PERMISSIONS.md
OWNER_LIDS=
# true  = messages sent from the bot's own phone/account count as OWNER (usual when the bot runs on your own number)
# false = the bot's own account gets no special rights (use when the bot has its own dedicated number)
SELF_IS_OWNER=true

# ───────── OPTIONAL: bot ─────────
BOT_NAME=ModBot
PREFIX=.
COMMAND_COOLDOWN_MS=2000
# Ignore messages older than this many seconds (prevents replaying backlog after reconnect)
MAX_MESSAGE_AGE_SEC=60

# ───────── OPTIONAL: login ─────────
# Set a number (digits only) to log in with a pairing CODE instead of scanning a QR.
PAIRING_NUMBER=

# ───────── OPTIONAL: storage ─────────
DATA_DIR=./data
AUTH_DIR=./data/auth

# ───────── OPTIONAL: baileys-antiban ─────────
# conservative | moderate | aggressive | high-volume
ANTIBAN_PRESET=moderate
# 0 = no warm-up (fine for an established number). Use 7 for a brand-new number.
ANTIBAN_WARMUP_DAYS=0
# false = never inject fake typos into bot replies (recommended for a moderation bot)
LEGIT_SIGNALS=false

# Group-operation ceilings (WhatsApp starts restricting accounts that add/remove too fast)
MAX_ADDS_PER_10MIN=3
MAX_KICKS_PER_10MIN=10

# silent | error | warn | info | debug
LOG_LEVEL=info
