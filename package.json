{
  "name": "wa-modbot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/qrcode-terminal": "^0.12.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "baileys": "7.0.0-rc14",
    "baileys-antiban": "4.10.0",
    "dotenv": "18.0.7",
    "pino": "10.4.0",
    "qrcode-terminal": "0.12.0"
  },
  "scripts": {
    "start": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "check": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "docs": "tsx scripts/gen-docs.ts",
    "build": "tsc --noEmit false --outDir dist --rootDir . --declaration false",
    "start:prod": "node dist/src/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "description": "Modular WhatsApp group-moderation bot on Baileys + baileys-antiban"
}